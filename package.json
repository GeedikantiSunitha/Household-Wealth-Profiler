{
  "name": "household-wealth-profiler",
  "version": "1.0.0",
  "description": "UK household onboarding, KYC/AML and CFA economic balance sheet for wealth management firms",
  "private": true,
  "license": "UNLICENSED",
  "main": "server.js",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node deploy/local/dev.js",
    "test": "node --test --test-timeout=300000 \"test/**/*.test.js\" \"backend/test/**/*.test.js\" \"frontend/test/**/*.test.js\" \"packages/core/test/**/*.test.js\"",
    "test:backend": "npm test --workspace backend",
    "test:frontend": "npm test --workspace frontend",
    "test:core": "npm test --workspace packages/core",
    "screens": "node test/e2e/screens.js",
    "build": "node scripts/build.js",
    "build:web": "node scripts/build-web.js",
    "check": "node scripts/ci/check-migrations.js db/migrations && node scripts/ci/check-licences.js",
    "vendor": "node scripts/vendor.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.2"
  }
}
