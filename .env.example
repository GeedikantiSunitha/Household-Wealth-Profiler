# Copy to .env (next to server.js) and fill in. Never commit the real file.
# The server reads .env itself (needs Node 22+). Variables already set in the environment win.

# Set to "production" on a live server. The server then refuses to start with the file store
# (DATABASE_URL required), with ALLOW_PLAINTEXT, with HSTS=0, or with HTTP Basic sign-in
# (AUTH_USERS), so none of the development conveniences can reach client data. It also refuses to
# start without PUBLIC_URL (https) and SMTP_URL (below): the sign-in needs both.
# NODE_ENV=production

# HTTP Basic sign-in: development and the file store only (production refuses it; people sign in
# through the app's own sign-in, which needs DATABASE_URL). One entry per user, separated by
# semicolons. Create each with:
#   node server.js hash-password NAME 'a long passphrase'
AUTH_USERS=

# 32-byte key, base64. Create with: node server.js gen-key
# Keep it in a secrets manager. Losing it means losing access to the data.
DATA_KEY=

# PostgreSQL (optional). When set, households, versions and the audit trail are stored here
# instead of in DATA_DIR. New db/migrations files are applied on start-up. Needs PostgreSQL 14+.
# Use a dedicated database and user. When the database is on another machine, require TLS and
# verify its certificate: ?sslmode=verify-full&sslrootcert=/path/to/ca.pem
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23, / -> %2F).
#   DATABASE_URL=postgres://hwp_app:PASSWORD@localhost:5432/wealth_profiler
DATABASE_URL=
# The server runs as hwp_app, which owns no table and cannot bypass row-level security.
# Migrations run as the owner of the tables: node server.js migrate, with this connection.
# In production the server refuses to start while a migration is pending (see README).
# DATABASE_OWNER_URL=postgres://hwp_owner:PASSWORD@localhost:5432/wealth_profiler
# The platform operator's connection, for the operator commands only (firm-create, create-user, ...): the
# operator role cannot read client records or account secrets, and needs no DATA_KEY (see README).
# DATABASE_OPERATOR_URL=postgres://hwp_operator:PASSWORD@localhost:5432/wealth_profiler
# A host that gives one login and cannot create roles (DCDeploy): DB_LOGIN_MODE=single, DATABASE_URL is
# that login, and DATABASE_OWNER_URL / DATABASE_OPERATOR_URL stay unset. The login must not be a
# superuser or bypass row-level security. Then: node server.js migrate, node server.js check-db-posture.
# DB_LOGIN_MODE=separate
# DATABASE_POOL_MAX=10

PORT=8080
# Address to listen on (default 0.0.0.0, every interface)
# HOST=127.0.0.1
# Behind a hosting proxy, the header the proxy sets to the real client address, so failed
# sign-ins lock out the right person (Fly.io: fly-client-ip). Only when the proxy overwrites it.
# CLIENT_IP_HEADER=
# Used when DATABASE_URL is empty
DATA_DIR=/data
# Set to 0 only when testing over plain http on your own machine
HSTS=1
# Local testing only: allows running without DATA_KEY (data stored unencrypted)
# ALLOW_PLAINTEXT=1

# The app's own sign-in (with DATABASE_URL). PUBLIC_URL is the address the app is served at: the
# links in emails point there, and an https address makes the session cookie Secure. Required, and
# https, in production.
# PUBLIC_URL=https://profiler.yourfirm.co.uk
# Email for reset and invitation links and sign-in warnings: smtps://USER:PASSWORD@host:465 (TLS from
# the start) or smtp://USER:PASSWORD@host:587 (STARTTLS, refused if the server does not offer it).
# Required in production, where tls=off is refused. Without it, outside production, each email is
# written to the server log instead. URL-encode special characters in the password.
# SMTP_URL=
# SMTP_FROM=Household Wealth Profiler <no-reply@yourfirm.co.uk>
# Who is told about a new access request from the sign-in page
# OPERATOR_EMAIL=
# A session ends after this many minutes without use, and in any case after this many hours
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12

# Optional: free key from alphavantage.co for automatic monthly prices of exchange-listed
# funds (ETFs, investment trusts). OEICs and unit trusts are imported from CSV instead.
ALPHAVANTAGE_KEY=

# Records retention (Phase 4): how many whole years a household is kept after its relationship
# ends, before a purge may be approved. The Money Laundering Regulations 2017 set 5 (the minimum
# accepted); a firm may keep longer.
# RETENTION_YEARS=5

# Backups: node server.js backup (on a schedule) and node server.js restore-drill (to prove a
# backup comes back). These run as a job of their own, not in the server:
#   BACKUP_DATABASE_URL  a role that reads every row (superuser or BYPASSRLS; never hwp_app or
#                        hwp_owner, which row security stops); the drill also needs CREATEDB
#   BACKUP_DIR           where the encrypted backups go; copy it off the hosting platform
#   BACKUP_KEY           32 bytes, base64 (node server.js gen-key). Its own key, never DATA_KEY:
#                        keep the two apart, and both apart from the backups. Losing it means
#                        losing the backups.
#   BACKUP_RETENTION_DAYS  backups older than this are removed (default 35; the newest is always kept)
#   PG_BIN               the folder of pg_dump / pg_restore if not on the PATH (version >= server's)
# The backup job does not need DATA_KEY; the restore drill does (it proves records still open).
# BACKUP_DATABASE_URL=
# BACKUP_DIR=
# BACKUP_KEY=
# BACKUP_RETENTION_DAYS=35
# PG_BIN=
