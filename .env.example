# Copy to .env (next to server.js) and fill in. Never commit the real file.
# server.js reads .env itself (Node 20.12+). Variables already set in the environment win.

# One entry per user, separated by semicolons. Create each with:
#   node server.js hash-password NAME 'a long passphrase'
AUTH_USERS=

# 32-byte key, base64. Create with: node server.js gen-key
# Keep it in a secrets manager. Losing it means losing access to the data.
DATA_KEY=

# PostgreSQL (optional). When set, households, versions and the audit trail are stored here
# instead of in DATA_DIR. Tables are created on start-up (db/schema.sql). Needs PostgreSQL 14+.
# Use a dedicated database and user; add ?sslmode=require when the database is on another machine.
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23, / -> %2F).
#   DATABASE_URL=postgres://hwp_app:PASSWORD@localhost:5432/wealth_profiler
DATABASE_URL=
# DATABASE_POOL_MAX=10

PORT=8080
# Used when DATABASE_URL is empty
DATA_DIR=/data
# Set to 0 only when testing over plain http on your own machine
HSTS=1
# Local testing only: allows running without DATA_KEY (data stored unencrypted)
# ALLOW_PLAINTEXT=1
