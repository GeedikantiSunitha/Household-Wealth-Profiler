# The front end's settings. They hold no secret: everything secret belongs to the back end
# (backend/.env.example), and nothing here ever reaches the browser.
#
# On DCDeploy there is no file: enter BACKEND_URL as an environment variable of the front-end service.
# On your machine, npm start --workspace frontend reads frontend/.env (copy this file there); variables
# already set in the environment win.

# The back end's internal address: where the front end passes the browser's /api/, /healthz and
# /readyz calls. On DCDeploy, the back-end service's internal link with port 3001, both services in the
# same environment, e.g. http://<back-end internal hostname>:3001 (not its public address). On your
# machine, the back end started with npm start --workspace backend. API_UPSTREAM, its earlier name, is
# still accepted when this is unset. A wrong host stops the container: "host not found in upstream".
BACKEND_URL=http://localhost:3001

# The Host header sent to the back end. Leave unset: the default keeps the public address, which the
# back end's same-site check compares with the browser's Origin. Set it only when BACKEND_URL has to be
# the back end's public https address (a host with no private network), to that address's host name.
# API_HOST=

# The split-address mode, like ModelMyWealth: the back end's own public address, https://api.yourfirm.co.uk.
# The page then calls it directly and the page's content security policy allows it; the back end must
# list this front end's address in its FRONTEND_ORIGIN (backend/.env.example). Unset (the default): one
# address, the page calls api/ here and the web tier passes it on to BACKEND_URL. With this set,
# BACKEND_URL defaults to it, so the container starts on a host with no private network.
# API_BASE_URL=

# Development server only (npm start --workspace frontend): the port, and the folder it serves
# (frontend/src as it is, or frontend/dist to check a build).
# FRONTEND_PORT=5173
# FRONTEND_DIR=frontend/src
